class Solution:
    def palindromePath(self, n: int, edges: list[list[int]],
                       s: str, queries: list[str]) -> list[bool]:

        graph = [[] for _ in range(n)]

        for u, v in edges:
            graph[u].append(v)
            graph[v].append(u)

        LOG = n.bit_length()

        parent = [[0] * LOG for _ in range(n)]
        depth = [0] * n
        tin = [0] * n
        tout = [0] * n
        prefix = [0] * n

        timer = 0

       
        stack = [(0, -1, 0)]

        while stack:
            u, p, state = stack.pop()

            if state == 0:
                tin[u] = timer
                timer += 1

                parent[u][0] = p if p != -1 else 0

                if p == -1:
                    prefix[u] = 1 << (ord(s[u]) - ord('a'))
                else:
                    prefix[u] = (
                        prefix[p] ^ (1 << (ord(s[u]) - ord('a')))
                    )

                stack.append((u, p, 1))

                for v in reversed(graph[u]):
                    if v != p:
                        depth[v] = depth[u] + 1
                        stack.append((v, u, 0))
            else:
                tout[u] = timer

       
        for j in range(1, LOG):
            for u in range(n):
                parent[u][j] = parent[parent[u][j - 1]][j - 1]

        
        bit = [0] * (n + 2)

        def update(i, value):
            while i <= n:
                bit[i] ^= value
                i += i & -i

        def query_bit(i):
            result = 0
            while i > 0:
                result ^= bit[i]
                i -= i & -i
            return result

        def range_xor(left, right, value):
            update(left + 1, value)
            update(right + 1, value)

        def get_prefix(u):
            return prefix[u] ^ query_bit(tin[u] + 1)

        def lca(u, v):
            if depth[u] < depth[v]:
                u, v = v, u

            diff = depth[u] - depth[v]

            for j in range(LOG):
                if diff & (1 << j):
                    u = parent[u][j]

            if u == v:
                return u

            for j in range(LOG - 1, -1, -1):
                if parent[u][j] != parent[v][j]:
                    u = parent[u][j]
                    v = parent[v][j]

            return parent[u][0]

        chars = list(s)
        answer = []

        for q in queries:
            parts = q.split()

            if parts[0] == "update":
                u = int(parts[1])
                c = parts[2]

                old_mask = 1 << (ord(chars[u]) - ord('a'))
                new_mask = 1 << (ord(c) - ord('a'))

                if old_mask != new_mask:
                    delta = old_mask ^ new_mask

                    range_xor(tin[u], tout[u], delta)
                    chars[u] = c

            else:
                u = int(parts[1])
                v = int(parts[2])

                ancestor = lca(u, v)

                mask = (
                    get_prefix(u)
                    ^ get_prefix(v)
                    ^ (1 << (ord(chars[ancestor]) - ord('a')))
                )

                
                answer.append((mask & (mask - 1)) == 0)

        return answer
