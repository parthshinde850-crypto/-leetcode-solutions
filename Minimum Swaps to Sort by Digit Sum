class Solution:
    def minSwaps(self, nums: list[int]) -> int:
        def get_digit_sum(num: int) -> int:
            s = 0
            while num > 0:
                s += num % 10
                num //= 10
            return s
        
        sorted_nums = sorted(nums, key=lambda x: (get_digit_sum(x), x))
        num_to_target_index = {num: i for i, num in enumerate(sorted_nums)}
        
        ans = 0
        seen = set()
        
        for i, num in enumerate(nums):
            if i in seen or num_to_target_index[num] == i:
                continue
                
            cycle_size = 0
            j = i
            while j not in seen:
                seen.add(j)
                j = num_to_target_index[nums[j]]
                cycle_size += 1
                
            if cycle_size > 1:
                ans += cycle_size - 1
                
        return ans
