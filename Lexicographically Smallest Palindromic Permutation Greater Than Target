class Solution:
    def lexPalindromicPermutation(self, s: str, target: str) -> str:
        n = len(s)
        half = n // 2

        cnt = [0] * 26

        for ch in s:
            cnt[ord(ch) - ord('a')] += 1

     
        middle = ""

        for i in range(26):
            if cnt[i] % 2 == 1:
                if middle:
                    return ""
                middle = chr(ord('a') + i)
                cnt[i] -= 1

        def valid():
            return all(x >= 0 for x in cnt)

       
        for i in range(half):
            cnt[ord(target[i]) - ord('a')] -= 2

        if valid():
            left = target[:half]

            candidate = left + middle + left[::-1]

            if candidate > target:
                return candidate

       
        for i in range(half - 1, -1, -1):

            x = ord(target[i]) - ord('a')

            
            cnt[x] += 2

            if not valid():
                continue

           
            for c in range(x + 1, 26):

                if cnt[c] < 2:
                    continue

                left = target[:i] + chr(ord('a') + c)

                
                cnt[c] -= 2

               
                for _ in range(i + 1, half):

                    for k in range(26):
                        if cnt[k] >= 2:
                            left += chr(ord('a') + k)
                            cnt[k] -= 2
                            break

                
                return left + middle + left[::-1]

        return ""
