from collections import deque

class Solution:
    def minMoves(self, classroom, energy):
        m = len(classroom)
        n = len(classroom[0])

       
        litter = {}
        start = None

        for i in range(m):
            for j in range(n):
                if classroom[i][j] == 'L':
                    litter[(i, j)] = len(litter)
                elif classroom[i][j] == 'S':
                    start = (i, j)

        k = len(litter)

       
        if k == 0:
            return 0

        
        queue = deque()
        queue.append((start[0], start[1], energy, 0, 0))

        
        visited = set()
        visited.add((start[0], start[1], energy, 0))

        directions = [(1, 0), (-1, 0), (0, 1), (0, -1)]

        while queue:
            r, c, e, mask, moves = queue.popleft()

            for dr, dc in directions:
                nr = r + dr
                nc = c + dc

               
                if nr < 0 or nr >= m or nc < 0 or nc >= n:
                    continue

               
                if classroom[nr][nc] == 'X':
                    continue

               
                if e == 0:
                    continue

                ne = e - 1
                nmask = mask

                
                if classroom[nr][nc] == 'L':
                    idx = litter[(nr, nc)]
                    nmask |= (1 << idx)

                
                if classroom[nr][nc] == 'R':
                    ne = energy

                
                if nmask == (1 << k) - 1:
                    return moves + 1

                state = (nr, nc, ne, nmask)

                if state not in visited:
                    visited.add(state)
                    queue.append((nr, nc, ne, nmask, moves + 1))

        return -1
