class Solution:
    def minInsertions(self, s: str) -> int:
        open = 0
        ans = 0

        for ch in s:
            if ch == '(':
                if open % 2 == 1:
                    ans += 1
                    open -= 1

                open += 2
            else:
                open -= 1

                if open < 0:
                    ans += 1
                    open = 1

        return ans + open
