import heapq

class Solution:
    def shortestPath(self, n, edges, labels, k):
        adj = [[] for _ in range(n)]

        for u, v, w in edges:
            adj[u].append((v, w))

        INF = float('inf')

        dist = [[INF] * (k + 1) for _ in range(n)]

        pq = []

        dist[0][1] = 0
        heapq.heappush(pq, (0, 0, 1))

        while pq:
            wt, u, count = heapq.heappop(pq)

            if u == n - 1:
                return wt

            if wt > dist[u][count]:
                continue

            for v, w in adj[u]:

                if labels[u] == labels[v]:
                    next_count = count + 1
                else:
                    next_count = 1

                if next_count > k:
                    continue

                new_wt = wt + w

                if new_wt < dist[v][next_count]:
                    dist[v][next_count] = new_wt

                    heapq.heappush(
                        pq, (new_wt, v, next_count)
                    )

        return -1
